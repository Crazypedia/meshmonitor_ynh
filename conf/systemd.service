[Unit]
Description=MeshMonitor - Meshtastic monitoring dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__
# protobufLoader.ts resolves the protobufs/ dir from process.cwd(), so WorkingDirectory must be the install dir.
EnvironmentFile=__INSTALL_DIR__/.env
Environment="PATH=__PATH_WITH_NODEJS__"
ExecStart=__NODEJS_DIR__/node __INSTALL_DIR__/dist/server/server.js
Restart=always
RestartSec=10
StandardOutput=append:/var/log/__APP__/__APP__.log
StandardError=append:/var/log/__APP__/__APP__.log
SyslogIdentifier=__APP__

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
# NOTE: ProtectHome must NOT be enabled. YunoHost's data_dir lives under
# /home/yunohost.app/__APP__; ProtectHome=true masks /home with an empty tmpfs,
# hiding the data dir before ReadWritePaths can expose it, which makes the app
# crash-loop with EACCES creating its SQLite database. ProtectSystem=strict
# already keeps the rest of /home read-only; ReadWritePaths re-opens the data dir.
PrivateTmp=true
ReadWritePaths=__DATA_DIR__ /var/log/__APP__

[Install]
WantedBy=multi-user.target
