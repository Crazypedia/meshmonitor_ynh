# MeshMonitor environment — generated by the YunoHost package. Managed; edits may be overwritten on upgrade.

# --- Meshtastic node connection ---
MESHTASTIC_NODE_IP=__NODE_IP__
MESHTASTIC_TCP_PORT=__NODE_PORT__

# --- Application ---
NODE_ENV=production
PORT=__PORT__

# Served under a subpath when path != "/" (empty string means root)
BASE_URL=__BASE_URL__

# --- Data / database ---
DATA_DIR=__DATA_DIR__
DATABASE_PATH=__DATA_DIR__/meshmonitor.db

# --- Behind YunoHost's nginx (HTTPS reverse proxy) ---
TRUST_PROXY=true
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://__DOMAIN__

# --- Security ---
SESSION_SECRET=__SESSION_SECRET__

# --- YunoHost SSO (SSOwat header auth) ---
# Portal users are auto-logged-in: nginx.conf maps SSOwat's YNH_USER_EMAIL into the
# Remote-User header, which MeshMonitor's proxy auth reads to provision/log in users.
# The built-in admin/changeme account stays available as a break-glass login.
PROXY_AUTH_ENABLED=true
PROXY_AUTH_HEADER_EMAIL=Remote-User
PROXY_AUTH_AUTO_PROVISION=true
# Comma-separated emails granted MeshMonitor admin (from the admin_email install question).
PROXY_AUTH_ADMIN_EMAILS=__ADMIN_EMAIL__
# Send MeshMonitor's logout to the YunoHost portal logout.
PROXY_AUTH_LOGOUT_URL=https://__DOMAIN__/yunohost/sso/?action=logout
