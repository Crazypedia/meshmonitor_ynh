# MeshMonitor environment — generated by the YunoHost package. Managed; edits may be overwritten on upgrade.

# --- Meshtastic node connection ---
MESHTASTIC_NODE_IP=__NODE_IP__
MESHTASTIC_TCP_PORT=__NODE_PORT__

# --- Application ---
NODE_ENV=production
PORT=__PORT__

# Served under a subpath when path != "/" (empty string means root)
BASE_URL=__BASE_URL__

# --- Data / database ---
DATA_DIR=__DATA_DIR__
DATABASE_PATH=__DATA_DIR__/meshmonitor.db

# These three have their own env vars upstream, each defaulting to a hardcoded
# /data/... path baked in for the Docker image. They do NOT derive from DATA_DIR,
# so they must be set explicitly here — otherwise the app tries to mkdir /data/...
# at runtime and fails (systemd ProtectSystem=strict makes / read-only), which
# breaks the backup/restore feature.
BACKUP_DIR=__DATA_DIR__/backups
SYSTEM_BACKUP_DIR=__DATA_DIR__/system-backups
APPRISE_CONFIG_DIR=__DATA_DIR__/apprise-config

# Off by default upstream; pointed at the app's log dir so logrotate picks it up.
ACCESS_LOG_PATH=/var/log/__APP__/access.log

# --- Behind YunoHost's nginx (HTTPS reverse proxy) ---
TRUST_PROXY=true
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://__DOMAIN__

# --- Security ---
SESSION_SECRET=__SESSION_SECRET__
